---
import LayoutAstroComponent from "../../layouts/Layout.astro";
import SectionDetalleBlog from "../../components/blog/cp/section-detalle-blog.astro";
import SectionRelacionadosBlog from "../../components/blog/cp/section-relacionados-blog.astro";
import SectionCtaProyecto from "../../components/proyectos/cp-[id]/section-cta-proyecto.astro";
import CTAAgencia from "../../components/share-ui/CTAAgencia.astro";
import { Fetch } from "../../lib/Fetch-Public-Informacion";
import type { tp_blogs, tp_blog_single } from "../../components/blog/types/tp-blog";

const { id_blog } = Astro.params;

const [singleData, listData]: [tp_blog_single, tp_blogs] = await Promise.all([
  Fetch({ pathname: `/api/blogs/${id_blog}?populate=*` }),
  Fetch({ pathname: "/api/blogs?populate=*" }),
]);

const post = singleData?.data;
const posts = listData?.data ?? [];

if (!post) {
  return Astro.redirect("/404");
}
---

<LayoutAstroComponent
  title={`${post.titulo} — Urpirio Dev`}
  description={post.subtitulo ?? post.titulo}
>
  <SectionDetalleBlog post={post} />
  <SectionRelacionadosBlog posts={posts} actual={post} />
  {post.cta ? (
    <SectionCtaProyecto cta={post.cta} />
  ) : (
    <CTAAgencia variant="outline" />
  )}
</LayoutAstroComponent>
