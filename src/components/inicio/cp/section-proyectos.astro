---
import CardProyecto from "../../share-ui/CardProyecto.astro";
import { Icon } from "astro-icon/components";
import { Fetch, API_URL } from "../../../lib/Fetch-Public-Informacion";
import type { tp_proyectos, tp_section_proyecto } from "../types/tp-proyectos";

const data: tp_section_proyecto = await Fetch({
  pathname: "/api/section-proyecto?populate=*",
});

const proyectos = Array.isArray(data.data) ? data.data : (data.data?.proyectos || []);
---

<section id="proyectos" class="relative scroll-mt-24 overflow-hidden px-6 py-20 sm:px-10 sm:py-32 bg-white">
  <!-- Fondos decorativos modernos -->
  <div class="pointer-events-none absolute inset-0 -z-10">
    <div class="absolute left-1/3 top-0 h-96 w-96 -translate-x-1/2 rounded-full bg-linear-to-br from-[#38b000]/12 via-[#38b000]/5 to-transparent blur-3xl"></div>
    <div class="absolute right-1/4 top-1/3 h-96 w-96 rounded-full bg-linear-to-br from-[#38b000]/8 via-transparent to-transparent blur-3xl"></div>
  </div>

  <div class="mx-auto max-w-3xl text-center">
    <div class="inline-block">
      <span class="inline-flex items-center gap-2 rounded-full border border-[#38b000]/20 bg-[#38b000]/10 px-4 py-1.5 text-xs font-bold uppercase tracking-widest text-[#38b000]">
        <Icon name="lucide:folder-git-2" class="h-3.5 w-3.5" />
        Mi trabajo
      </span>
    </div>

    <h2 class="mt-6 text-balance text-5xl font-black tracking-tight text-neutral-900 sm:text-6xl">
      {Array.isArray(data.data) ? data.data[0]?.titulo : data.data?.titulo}
    </h2>

    <p class="mt-6 text-lg leading-8 text-neutral-600">
      {Array.isArray(data.data) ? data.data[0]?.subtitulo : data.data?.subtitulo}
    </p>
  </div>

  <div class="mx-auto mt-16 grid max-w-7xl grid-cols-1 gap-8 sm:grid-cols-2 lg:grid-cols-3">
    <!-- Estado vacío -->
    {proyectos.length === 0 && (
      <div class="col-span-full flex flex-col items-center justify-center rounded-3xl border border-dashed border-neutral-300 bg-neutral-50/60 px-6 py-20 text-center">
        <div class="flex h-14 w-14 items-center justify-center rounded-2xl bg-[#38b000]/10 text-[#38b000]">
          <Icon name="lucide:folder-open" class="h-7 w-7" />
        </div>
        <p class="mt-5 text-lg font-semibold text-neutral-900">Proyectos en camino</p>
        <p class="mt-1 max-w-sm text-sm text-neutral-500">
          Estoy preparando algunos trabajos para mostrarlos aquí muy pronto.
        </p>
      </div>
    )}

    {proyectos.map((proyecto: any) => {
      const imagen = proyecto.images?.[0] ?? proyecto.documentos?.[0];
      return (
        <CardProyecto
          titulo={proyecto.titulo}
          descripcion={proyecto.descripcion}
          categoria={proyecto.categoria_proyectos?.[0]?.nombre}
          tecnologias={(proyecto.tecnologia_proyectos ?? []).map((t: any) => t.nombre)}
          imagen={imagen?.url ? `${API_URL}${imagen.url}` : undefined}
          href={`/proyectos/${proyecto.documentId}`}
          maxTecnologias={3}
        />
      );
    })}
  </div>

  <!-- CTA final -->
  <div class="mt-16 flex justify-center">
    <a
      href="/proyectos"
      class="group relative inline-flex items-center gap-3 rounded-full border border-neutral-300 bg-white px-8 py-3.5 font-bold text-neutral-800 shadow-sm transition-all duration-300 hover:border-[#38b000] hover:text-[#38b000] hover:bg-[#38b000]/5 hover:shadow-md"
    >
      <span>Explorar todos los proyectos</span>
      <span class="transition-transform duration-300 group-hover:translate-x-1">→</span>
    </a>
  </div>
</section>
