---
// Marquee embebible de empresas. Logos en: public/logos/
const empresas = [
  {
    nombre: "OGTIC",
    descripcion: "Oficina Gubernamental de Tecnologías",
    logo: "/logos/Ogtic-Logo.png",
    url: "https://ogtic.gob.do",
  },
  {
    nombre: "ITU",
    descripcion: "Unión Internacional de Telecomunicaciones",
    logo: "/logos/Itu-Logo.png",
    url: "https://www.itu.int",
  },
  {
    nombre: "Siddhatech",
    descripcion: "Innovate, Plan, Execute",
    logo: "/logos/Siddhatech.png",
    url: "https://siddhatech.com",
  },
];

// Repetimos la lista para llenar el ancho; el track se duplica para el loop.
const secuencia = [...empresas, ...empresas, ...empresas, ...empresas];
const track = [...secuencia, ...secuencia];
---

<div
  class="marquee relative overflow-hidden mask-[linear-gradient(to_right,transparent,black_10%,black_90%,transparent)]"
>
  <div class="marquee-track flex w-max items-center">
    {
      track.map((empresa, i) => (
        <a
          href={empresa.url}
          target="_blank"
          rel="noreferrer"
          aria-label={empresa.nombre}
          aria-hidden={i >= secuencia.length ? "true" : undefined}
          title={`${empresa.nombre} — ${empresa.descripcion}`}
          tabindex={i >= secuencia.length ? -1 : undefined}
          class="mx-8 flex shrink-0 items-center opacity-60 grayscale transition-all duration-300 hover:opacity-100 hover:grayscale-0 sm:mx-10"
        >
          <img
            src={empresa.logo}
            alt={empresa.nombre}
            class="h-8 w-auto max-w-32 object-contain sm:h-10"
            loading="lazy"
          />
        </a>
      ))
    }
  </div>
</div>

<style>
  @keyframes marquee-scroll {
    from {
      transform: translateX(0);
    }
    to {
      transform: translateX(-50%);
    }
  }

  .marquee-track {
    animation: marquee-scroll 30s linear infinite;
    will-change: transform;
  }

  .marquee:hover .marquee-track {
    animation-play-state: paused;
  }

  @media (prefers-reduced-motion: reduce) {
    .marquee-track {
      animation: none;
    }
  }
</style>
