---
import { Icon } from "astro-icon/components";
import MarqueeEmpresas from "./marquee-empresas.astro";
import { Fetch } from "../../../lib/Fetch-Public-Informacion";
import type { tp_sobre_mi } from "../types/tp-sobre-me";

const valores = [
  {
    icon: "lucide:code",
    titulo: "Código limpio",
    descripcion: "Escribo pensando en quien lo mantendrá después, incluido yo.",
  },
  {
    icon: "lucide:palette",
    titulo: "Diseño y detalle",
    descripcion: "Cuido cómo se ve y cómo se siente cada pantalla.",
  },
  {
    icon: "lucide:zap",
    titulo: "Rendimiento real",
    descripcion: "Sitios ligeros y rápidos, sin peso de más.",
  },
];

const stats = [
  { valor: "20+", etiqueta: "Tecnologías" },
  { valor: "3", etiqueta: "Roles profesionales" },
  { valor: "1er", etiqueta: "Asistente IA del Estado 🇩🇴" },
];

const data: tp_sobre_mi = await Fetch({ pathname: "/api/section-about-me" });
---

<section
  id="sobre-mi"
  class="relative scroll-mt-24 overflow-hidden bg-white px-6 py-16 text-neutral-900 sm:px-10 sm:py-20"
>
  <!-- Fondos decorativos -->
  <div class="pointer-events-none absolute inset-0 z-0">
    <div class="absolute left-1/2 top-0 h-100 w-100 -translate-x-1/2 rounded-full bg-linear-to-b from-[#38b000]/15 to-transparent blur-3xl"></div>
    <div class="absolute bottom-0 right-1/4 h-72 w-72 rounded-full bg-linear-to-t from-[#38b000]/5 to-transparent blur-3xl"></div>
  </div>

  <div class="relative mx-auto max-w-3xl text-center">
    <span class="inline-block rounded-full border border-[#38b000]/20 bg-[#38b000]/10 px-4 py-1.5 text-xs font-semibold uppercase tracking-widest text-[#38b000]">
      Quién soy
    </span>

    <h2 class="mt-5 text-balance text-4xl font-bold tracking-tight text-neutral-900 sm:text-5xl">
      Más que líneas de <span class="text-[#38b000]">código</span>
    </h2>

    <p class="mx-auto mt-4 max-w-2xl text-base leading-relaxed text-neutral-600">
      Desarrollador de software dominicano. Lideré la parte técnica del
      <span class="font-semibold text-neutral-900">primer asistente de IA del Estado dominicano</span>
      y disfruto convertir ideas en productos que se sienten bien de usar. Creo
      que el mejor código es el que se entiende sin necesidad de explicarlo.
    </p>
  </div>

  <!-- Valores / forma de trabajar -->
  <div class="relative mx-auto mt-10 grid max-w-4xl grid-cols-1 gap-4 sm:grid-cols-3">
    {
      valores.map((valor) => (
        <div class="group relative overflow-hidden rounded-2xl border border-neutral-200 bg-neutral-50/60 p-5 text-left transition-all duration-300 hover:border-[#38b000]/40 hover:-translate-y-1 hover:bg-white hover:shadow-md">
          <div class="flex h-10 w-10 items-center justify-center rounded-xl bg-[#38b000]/10 text-[#38b000] transition-colors duration-300 group-hover:bg-[#38b000]/20">
            <Icon name={valor.icon} class="h-5 w-5" />
          </div>
          <h3 class="mt-3 text-base font-bold text-neutral-900">{valor.titulo}</h3>
          <p class="mt-1.5 text-sm leading-relaxed text-neutral-600">
            {valor.descripcion}
          </p>
        </div>
      ))
    }
  </div>

  <!-- Estadísticas -->
  <div class="relative mx-auto mt-4 grid max-w-4xl grid-cols-3 divide-x divide-neutral-200 rounded-2xl border border-neutral-200 bg-neutral-50/60 py-5">
    {
      stats.map((stat) => (
        <div class="px-3 text-center">
          <p class="bg-linear-to-b from-[#38b000] to-[#2d8d00] bg-clip-text text-3xl font-black text-transparent sm:text-4xl">
            {stat.valor}
          </p>
          <p class="mt-1 text-xs text-neutral-600 sm:text-sm">{stat.etiqueta}</p>
        </div>
      ))
    }
  </div>

  <!-- Empresas donde he trabajado -->
  <div class="relative mx-auto mt-10 max-w-4xl">
    <p class="text-center text-xs font-medium uppercase tracking-widest text-neutral-400">
      He trabajado con
    </p>
    <div class="mt-4">
      <MarqueeEmpresas />
    </div>
  </div>

  <div class="relative mt-10 flex justify-center">
    <a
      href="/sobre-me"
      class="group inline-flex items-center gap-2 rounded-full border border-neutral-300 px-7 py-3.5 font-medium text-neutral-800 transition-all duration-300 hover:border-[#38b000] hover:bg-[#38b000]/5 hover:text-[#38b000]"
    >
      <span>Conoce mi historia</span>
      <span class="transition-transform duration-300 group-hover:translate-x-1">→</span>
    </a>
  </div>
</section>
