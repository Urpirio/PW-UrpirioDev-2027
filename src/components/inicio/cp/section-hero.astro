---
import { Icon } from "astro-icon/components";
import { API_URL, Fetch } from "../../../lib/Fetch-Public-Informacion";
import { resolverRedes } from "../../../lib/redes-sociales";
import type { tp_hero } from "../types/tp-hero";

// Posición del arreglo flotante de cada red (solo relevante en el hero).
const POSICIONES: Record<string, { top: string; left: string }> = {
  github: { top: "8%", left: "-4%" },
  githud: { top: "8%", left: "-4%" },
  linkedin: { top: "60%", left: "-6%" },
  instagram: { top: "78%", left: "92%" },
  email: { top: "30%", left: "96%" },
};

const stack = [
  { nombre: "Astro", icon: "simple-icons:astro" },
  { nombre: "React", icon: "simple-icons:react" },
  { nombre: "TypeScript", icon: "simple-icons:typescript" },
  { nombre: "Tailwind", icon: "simple-icons:tailwindcss" },
  { nombre: "Node.js", icon: "simple-icons:nodedotjs" },
];

const checklist = ["Amante del anime", "Adicto al café", "Siempre aprendiendo"];

const data: tp_hero = await Fetch({
  pathname: "/api/section-hero?populate=*",
});

const hero = data?.data;
const mostrarSeccion = hero?.Show_section ?? true;

const subtitulo =
  hero?.descripcion ??
  "Desarrollador web al que le apasiona construir cosas limpias y bien hechas. Aquí comparto mis proyectos, lo que voy aprendiendo y un poco de quién soy.";

const redes = resolverRedes(hero?.redes_sociales).map((red) => ({
  ...red,
  ...(POSICIONES[red.titulo?.toLowerCase()?.trim()] ?? { top: "0%", left: "0%" }),
}));

const imagenesCms = hero?.images ?? [];
const fotoUrl = imagenesCms[0]?.url ? `${API_URL}${imagenesCms[0].url}` : undefined;
const fotoAltUrl = imagenesCms[1]?.url ? `${API_URL}${imagenesCms[1].url}` : undefined;
---

{mostrarSeccion && (
<section class="relative overflow-hidden px-6 py-14 sm:px-10 lg:py-20">
  <!-- Fondos decorativos -->
  <div class="pointer-events-none absolute inset-0 -z-10">
    <div
      class="absolute -right-20 top-0 h-125 w-125 rounded-full bg-linear-to-b from-[#38b000]/12 to-transparent blur-3xl"
    >
    </div>
    <div
      class="absolute left-0 bottom-0 h-72 w-72 rounded-full bg-linear-to-t from-[#38b000]/5 to-transparent blur-3xl"
    >
    </div>
  </div>

  <div
    class="mx-auto grid max-w-7xl grid-cols-1 items-center gap-10 lg:grid-cols-2 lg:gap-6"
  >
    <!-- Columna de texto -->
    <div class="text-center lg:text-left">
      <span
        class="hero-badge inline-flex items-center gap-2 rounded-full border border-[#38b000]/20 bg-[#38b000]/10 px-4 py-1.5 text-xs font-semibold uppercase tracking-widest text-[#38b000] opacity-0"
      >
        <span class="h-2 w-2 rounded-full bg-[#38b000]"></span>
        Bienvenido a mi portafolio
      </span>

      <h1
        class="hero-title mt-6 text-balance text-5xl font-black leading-[1.05] tracking-tight text-neutral-900 opacity-0 sm:text-6xl lg:text-7xl"
      >
        Hola, soy <span class="text-[#38b000]">Urpirio.</span>
      </h1>

      <p
        class="hero-subtitle mx-auto mt-6 max-w-lg text-base leading-relaxed text-neutral-500 opacity-0 lg:mx-0 sm:text-lg"
      >
        {subtitulo}
      </p>

      <div
        class="hero-cta mt-8 flex flex-col items-center justify-center gap-3 opacity-0 sm:flex-row lg:justify-start"
      >
        <a
          href="#proyectos"
          class="group inline-flex w-full items-center justify-center gap-2 rounded-full bg-linear-to-r from-[#38b000] to-[#2d8d00] px-7 py-3.5 font-semibold text-white shadow-lg shadow-[#38b000]/20 transition-all duration-300 hover:shadow-xl hover:shadow-[#38b000]/30 sm:w-auto"
        >
          Ver mis proyectos
          <span
            class="transition-transform duration-300 group-hover:translate-x-1"
            >→</span
          >
        </a>
        <a
          href="#sobre-mi"
          class="inline-flex w-full items-center justify-center gap-2 rounded-full border border-neutral-300 px-7 py-3.5 font-semibold text-neutral-800 transition-all duration-300 hover:border-[#38b000] hover:text-[#38b000] sm:w-auto"
        >
          <Icon name="lucide:user" class="h-4 w-4" />
          Sobre mí
        </a>
      </div>

      <div class="hero-stack mt-12 opacity-0">
        <p
          class="text-xs font-medium uppercase tracking-widest text-neutral-400"
        >
          Stack principal
        </p>
        <div
          class="mt-4 flex flex-wrap items-center justify-center gap-6 lg:justify-start"
        >
          {
            stack.map((tech) => (
              <span
                class="flex items-center gap-2 text-neutral-400 transition-colors duration-300 hover:text-[#38b000]"
                title={tech.nombre}
              >
                <Icon name={tech.icon} class="h-6 w-6" />
                <span class="text-sm font-semibold">{tech.nombre}</span>
              </span>
            ))
          }
        </div>
      </div>
    </div>

    <!-- Columna visual -->
    <div
      class="hero-visual relative mx-auto flex h-95 w-full max-w-md items-end justify-center sm:h-115 lg:h-135"
    >
      <!-- Anillos decorativos -->
      <div
        class="pointer-events-none absolute inset-0 flex items-center justify-center"
      >
        <div
          class="absolute h-90 w-90 rounded-full bg-linear-to-b from-[#38b000]/10 to-transparent blur-2xl sm:h-105 sm:w-105"
        >
        </div>
        <div
          class="absolute h-80 w-80 rounded-full border border-[#38b000]/20 sm:h-95 sm:w-95"
        >
        </div>
        <div
          class="absolute h-64 w-64 rounded-full border border-dashed border-[#38b000]/15 sm:h-76 sm:w-76"
        >
        </div>
        <!-- Puntos sobre el anillo -->
        <span
          class="absolute left-1/2 top-1/2 h-2.5 w-2.5 -translate-x-1/2 -translate-y-40 rounded-full bg-[#38b000] sm:-translate-y-48"
        ></span>
        <span
          class="absolute left-1/2 top-1/2 h-2 w-2 translate-x-38 translate-y-16 rounded-full bg-[#38b000]/70 sm:translate-x-46"
        ></span>
        <span
          class="absolute left-1/2 top-1/2 h-1.5 w-1.5 -translate-x-40 translate-y-8 rounded-full bg-[#38b000]/50 sm:-translate-x-48"
        ></span>
      </div>

      <!-- Foto con hover -->
      <div
        class="group relative z-10 flex h-full w-full items-end justify-center"
      >
        {fotoUrl ? (
          <>
            <img
              class:list={[
                "h-full w-auto object-contain object-bottom mask-b-from-85% mask-b-to-95% transition-opacity duration-300",
                fotoAltUrl && "group-hover:opacity-0",
              ]}
              src={fotoUrl}
              alt={imagenesCms[0]?.alternativeText ?? "Urpirio, desarrollador web"}
            />
            {fotoAltUrl && (
              <img
                class="absolute inset-0 mx-auto h-full w-auto object-contain object-bottom mask-b-from-85% mask-b-to-95% opacity-0 transition-opacity duration-300 group-hover:opacity-100"
                src={fotoAltUrl}
                alt={imagenesCms[1]?.alternativeText ?? "Foto alterna"}
              />
            )}
          </>
        ) : (
          // Placeholder: sin imágenes cargadas en el CMS
          <div class="flex h-full w-full max-w-70 items-center justify-center rounded-[2.5rem] bg-linear-to-br from-[#38b000]/15 via-neutral-50 to-[#38b000]/5">
            <span class="text-8xl font-black text-[#38b000]/25">U</span>
          </div>
        )}
      </div>


      <!-- Iconos sociales flotantes -->
      <div class="pointer-events-none absolute inset-0 hidden sm:block">
        {
          redes.map((red) => (
            <a
              href={red.href}
              target="_blank"
              rel="noreferrer"
              aria-label={red.titulo}
              class="floating-icon pointer-events-auto absolute z-30 flex h-11 w-11 items-center justify-center rounded-full border border-[#38b000]/30 bg-white/80 text-[#38b000] opacity-0 shadow-md backdrop-blur-sm transition-colors hover:border-[#38b000] hover:bg-[#38b000]/10"
              style={{ top: red.top, left: red.left }}
            >
              <Icon name={red.icon} class="h-5 w-5" />
            </a>
          ))
        }
      </div>
    </div>
  </div>
</section>
)}
<script>
  import { animate, stagger } from "motion";

  const reveal = [
    { sel: ".hero-badge", delay: 0.1, y: -12 },
    { sel: ".hero-title", delay: 0.2, y: 24 },
    { sel: ".hero-subtitle", delay: 0.35, y: 20 },
    { sel: ".hero-cta", delay: 0.5, y: 20 },
    { sel: ".hero-stack", delay: 0.65, y: 16 },
  ];

  reveal.forEach(({ sel, delay, y }) => {
    const el = document.querySelector<HTMLElement>(sel);
    if (!el) return;
    animate(
      el,
      { opacity: [0, 1], y: [y, 0] },
      { duration: 0.7, delay, ease: [0.22, 1, 0.36, 1] },
    );
  });

  const visual = document.querySelector<HTMLElement>(".hero-visual .group");
  if (visual) {
    animate(
      visual,
      { opacity: [0, 1], scale: [0.92, 1] },
      { duration: 0.8, delay: 0.3, ease: [0.22, 1, 0.36, 1] },
    );
  }

  const card = document.querySelector<HTMLElement>(".hero-card");
  if (card) {
    animate(
      card,
      { opacity: [0, 1], x: [24, 0], y: [-12, 0] },
      { duration: 0.7, delay: 0.9, ease: [0.22, 1, 0.36, 1] },
    );
    animate(
      card,
      { y: [0, -8, 0] },
      { duration: 4, delay: 1.6, repeat: Infinity, ease: "easeInOut" },
    );
  }

  const floatingIcons =
    document.querySelectorAll<HTMLElement>(".floating-icon");

  floatingIcons.forEach((icon, index) => {
    const duration = 3 + Math.random() * 2;
    const distance = 10 + Math.random() * 8;
    const rotate = 5 + Math.random() * 5;

    animate(
      icon,
      { opacity: [0, 1] },
      { duration: 0.6, delay: 0.8 + index * 0.15, ease: "easeOut" },
    );

    animate(
      icon,
      {
        y: [0, -distance, 0, distance, 0],
        rotate: [0, rotate, 0, -rotate, 0],
      },
      {
        duration,
        delay: index * 0.4,
        repeat: Infinity,
        ease: "easeInOut",
      },
    );
  });
</script>
