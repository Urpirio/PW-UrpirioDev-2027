---
import { Icon } from "astro-icon/components";
import { API_URL } from "../../../lib/Fetch-Public-Informacion";
import type { object_proyecto } from "../types/tp-proyectos";

interface Props {
  proyecto: object_proyecto;
}

const { proyecto } = Astro.props;

const inicial = (proyecto.titulo ?? "P").trim().charAt(0).toUpperCase();
const imagen = proyecto.documentos?.[0];
const categorias = proyecto.categoria_proyectos ?? [];
const tecnologias = proyecto.tecnologia_proyectos ?? [];

const fechaPublicacion = proyecto.publishedAt
  ? new Intl.DateTimeFormat("es-DO", { dateStyle: "long" }).format(
      new Date(proyecto.publishedAt),
    )
  : null;

const ficha = [
  categorias[0] && {
    icon: "lucide:tag",
    etiqueta: "Categoría",
    valor: categorias[0].nombre,
  },
  fechaPublicacion && {
    icon: "lucide:calendar",
    etiqueta: "Publicado",
    valor: fechaPublicacion,
  },
  tecnologias.length > 0 && {
    icon: "lucide:layers",
    etiqueta: "Tecnologías",
    valor: `${tecnologias.length}`,
  },
].filter(Boolean) as { icon: string; etiqueta: string; valor: string }[];
---

<article class="relative overflow-hidden px-6 py-16 sm:px-10 sm:py-20">
  <!-- Fondos decorativos -->
  <div class="pointer-events-none absolute inset-0 -z-10">
    <div class="absolute left-1/2 top-0 h-100 w-100 -translate-x-1/2 rounded-full bg-linear-to-b from-[#38b000]/12 to-transparent blur-3xl"></div>
  </div>

  <div class="relative mx-auto max-w-5xl">
    <!-- Volver -->
    <a
      href="/proyectos"
      class="group inline-flex items-center gap-2 text-sm font-medium text-neutral-500 transition-colors hover:text-[#38b000]"
    >
      <Icon
        name="lucide:arrow-left"
        class="h-4 w-4 transition-transform duration-300 group-hover:-translate-x-1"
      />
      Volver a proyectos
    </a>

    <!-- Encabezado -->
    <header class="mt-8">
      {categorias[0] && (
        <span class="inline-flex items-center gap-2 rounded-full border border-[#38b000]/20 bg-[#38b000]/10 px-4 py-1.5 text-xs font-bold uppercase tracking-widest text-[#38b000]">
          <Icon name="lucide:tag" class="h-3.5 w-3.5" />
          {categorias[0].nombre}
        </span>
      )}

      <h1 class="mt-5 text-balance text-4xl font-black tracking-tight text-neutral-900 sm:text-5xl">
        {proyecto.titulo}
      </h1>
      {proyecto.subtitulo && (
        <p class="mt-3 text-lg text-neutral-500">{proyecto.subtitulo}</p>
      )}

      {tecnologias.length > 0 && (
        <div class="mt-6 flex flex-wrap gap-2">
          {tecnologias.map((tec) => (
            <span class="rounded-full border border-[#38b000]/20 bg-[#38b000]/10 px-3 py-1 text-xs font-semibold text-[#2d8d00]">
              {tec.nombre}
            </span>
          ))}
        </div>
      )}
    </header>

    <!-- Portada -->
    <div class="mt-10 flex aspect-video w-full items-center justify-center overflow-hidden rounded-3xl border border-neutral-200 bg-linear-to-br from-[#38b000]/12 via-neutral-50 to-[#38b000]/5">
      {imagen ? (
        <img
          src={`${API_URL}${imagen.url}`}
          alt={imagen.alternativeText ?? proyecto.titulo}
          class="h-full w-full object-cover"
          loading="lazy"
        />
      ) : (
        <span class="text-8xl font-black text-[#38b000]/25 sm:text-9xl">
          {inicial}
        </span>
      )}
    </div>

    <!-- Contenido -->
    <div class="mt-12 grid grid-cols-1 gap-10 lg:grid-cols-[1.6fr_1fr]">
      <!-- Principal -->
      <div>
        <p class="text-lg leading-relaxed text-neutral-700">
          {proyecto.descripcion}
        </p>
      </div>

      <!-- Ficha técnica -->
      {ficha.length > 0 && (
        <aside class="lg:sticky lg:top-28 lg:self-start">
          <div class="rounded-3xl border border-neutral-200 bg-neutral-50/60 p-6">
            <p class="text-xs font-semibold uppercase tracking-widest text-neutral-400">
              Ficha del proyecto
            </p>
            <dl class="mt-5 space-y-5">
              {ficha.map((item) => (
                <div class="flex items-start gap-3">
                  <div class="flex h-9 w-9 shrink-0 items-center justify-center rounded-xl bg-white text-[#38b000] shadow-sm">
                    <Icon name={item.icon} class="h-4 w-4" />
                  </div>
                  <div>
                    <dt class="text-xs font-medium uppercase tracking-wide text-neutral-400">
                      {item.etiqueta}
                    </dt>
                    <dd class="text-sm font-semibold text-neutral-900">
                      {item.valor}
                    </dd>
                  </div>
                </div>
              ))}
            </dl>
          </div>
        </aside>
      )}
    </div>
  </div>
</article>
