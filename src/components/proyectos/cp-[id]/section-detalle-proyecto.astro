---
import { Icon } from "astro-icon/components";
import { API_URL } from "../../../lib/Fetch-Public-Informacion";
import { parseContenido } from "../../../lib/parse-rich-text";
import { getGaleriaImagenes } from "../lib/proyecto-utils";
import RichSegmento from "../../share-ui/RichSegmento.astro";
import CarouselImagenes from "../../share-ui/CarouselImagenes.astro";
import type { object_proyecto } from "../types/tp-proyectos";

interface Props {
  proyecto: object_proyecto;
}

const { proyecto } = Astro.props;

const inicial = (proyecto.titulo ?? "P").trim().charAt(0).toUpperCase();
const imagenes = getGaleriaImagenes(proyecto);
const categorias = proyecto.categoria_proyectos ?? [];
const tecnologias = proyecto.tecnologia_proyectos ?? [];
const archivos = proyecto.documentos ?? [];

const fechaPublicacion = proyecto.publishedAt
  ? new Intl.DateTimeFormat("es-DO", { dateStyle: "long" }).format(
      new Date(proyecto.publishedAt),
    )
  : null;

const ICONO_POR_EXTENSION: Record<string, string> = {
  ".pdf": "lucide:file-text",
  ".doc": "lucide:file-text",
  ".docx": "lucide:file-text",
  ".xls": "lucide:file-spreadsheet",
  ".xlsx": "lucide:file-spreadsheet",
  ".zip": "lucide:file-archive",
  ".rar": "lucide:file-archive",
};

const formatearTamano = (kb: number) => {
  if (kb < 1024) return `${Math.round(kb)} KB`;
  return `${(kb / 1024).toFixed(1)} MB`;
};

const ficha = [
  fechaPublicacion && {
    icon: "lucide:calendar",
    etiqueta: "Publicado",
    valor: fechaPublicacion,
  },
  tecnologias.length > 0 && {
    icon: "lucide:layers",
    etiqueta: "Tecnologías",
    valor: `${tecnologias.length}`,
  },
].filter(Boolean) as { icon: string; etiqueta: string; valor: string }[];

const bloques = parseContenido(proyecto.contenido);
---

<article class="relative overflow-hidden  py-16 0 sm:py-20">
  <!-- Fondos decorativos -->
  <div class="pointer-events-none absolute inset-0 -z-10">
    <div class="absolute left-1/2 top-0 h-100 w-100 -translate-x-1/2 rounded-full bg-linear-to-b from-[#38b000]/12 to-transparent blur-3xl"></div>
  </div>

  <div class="relative mx-auto max-w-6xl">
    <!-- Volver -->
    <a
      href="/proyectos"
      class="group inline-flex items-center gap-2 text-sm font-medium text-neutral-500 transition-colors hover:text-[#38b000]"
    >
      <Icon
        name="lucide:arrow-left"
        class="h-4 w-4 transition-transform duration-300 group-hover:-translate-x-1"
      />
      Volver a proyectos
    </a>

    <!-- Encabezado -->
    <header class="mt-8">

      <h1 class="mt-5 text-balance text-4xl font-black tracking-tight text-neutral-900 sm:text-5xl">
        {proyecto.titulo}
      </h1>
      {proyecto.subtitulo && (
        <p class="mt-3 text-lg text-neutral-500">{proyecto.subtitulo}</p>
      )}

      {tecnologias.length > 0 && (
        <div class="mt-6 flex flex-wrap gap-2">
          {tecnologias.map((tec) => (
            <span class="rounded-full border border-[#38b000]/20 bg-[#38b000]/10 px-3 py-1 text-xs font-semibold text-[#2d8d00]">
              {tec.nombre}
            </span>
          ))}
        </div>
      )}
    </header>

    <!-- Portada -->
    <div class="mt-10">
      <CarouselImagenes imagenes={imagenes} alt={proyecto.titulo} inicial={inicial} />
    </div>

    <!-- Contenido -->
    <div class="mt-12 grid grid-cols-1 gap-10 lg:grid-cols-[1.6fr_1fr]">
      <!-- Principal -->
      <div class="space-y-5">
        {bloques.length > 0 ? (
          bloques.map((bloque) => {
            if (bloque.tipo === "titulo") {
              const TagTitulo = bloque.nivel === 2 ? "h2" : "h3";
              return (
                <TagTitulo class="text-2xl font-bold text-neutral-900">
                  {bloque.segmentos!.map((seg) => (
                    <RichSegmento {...seg} />
                  ))}
                </TagTitulo>
              );
            }
            if (bloque.tipo === "lista") {
              const TagLista = bloque.ordenada ? "ol" : "ul";
              return (
                <TagLista class="space-y-2">
                  {bloque.items!.map((item) => (
                    <li class="flex gap-2.5 text-lg leading-relaxed text-neutral-700">
                      <Icon
                        name="lucide:check"
                        class="mt-1.5 h-4 w-4 shrink-0 text-[#38b000]"
                      />
                      <span>
                        {item.map((seg) => (
                          <RichSegmento {...seg} />
                        ))}
                      </span>
                    </li>
                  ))}
                </TagLista>
              );
            }
            if (bloque.tipo === "cita") {
              return (
                <blockquote class="border-l-4 border-[#38b000]/30 pl-4 text-lg italic leading-relaxed text-neutral-600">
                  {bloque.segmentos!.map((seg) => (
                    <RichSegmento {...seg} />
                  ))}
                </blockquote>
              );
            }
            return (
              <p class="text-lg leading-relaxed text-neutral-700">
                {bloque.segmentos!.map((seg) => (
                  <RichSegmento {...seg} />
                ))}
              </p>
            );
          })
        ) : (
          <p class="text-lg leading-relaxed text-neutral-700">
            {proyecto.descripcion}
          </p>
        )}
      </div>

      <!-- Ficha técnica -->
      {(ficha.length > 0 || categorias.length > 0 || archivos.length > 0) && (
        <aside class="lg:sticky lg:top-28 lg:self-start space-y-5">
          {(ficha.length > 0 || categorias.length > 0) && (
            <div class="rounded-3xl border border-neutral-200 bg-neutral-50/60 p-6">
              <p class="text-xs font-semibold uppercase tracking-widest text-neutral-400">
                Ficha del proyecto
              </p>
              <dl class="mt-5 space-y-5">
                {categorias.length > 0 && (
                  <div class="flex items-start gap-3">
                    <div class="flex h-9 w-9 shrink-0 items-center justify-center rounded-xl bg-white text-[#38b000] shadow-sm">
                      <Icon name="lucide:tag" class="h-4 w-4" />
                    </div>
                    <div>
                      <dt class="text-xs font-medium uppercase tracking-wide text-neutral-400">
                        {categorias.length > 1 ? "Categorías" : "Categoría"}
                      </dt>
                      <dd class="mt-1 flex flex-wrap gap-1.5">
                        {categorias.map((cat) => (
                          <span class="rounded-full bg-[#38b000]/10 px-2.5 py-1 text-xs font-semibold text-[#2d8d00]">
                            {cat.nombre}
                          </span>
                        ))}
                      </dd>
                    </div>
                  </div>
                )}
                {ficha.map((item) => (
                  <div class="flex items-start gap-3">
                    <div class="flex h-9 w-9 shrink-0 items-center justify-center rounded-xl bg-white text-[#38b000] shadow-sm">
                      <Icon name={item.icon} class="h-4 w-4" />
                    </div>
                    <div>
                      <dt class="text-xs font-medium uppercase tracking-wide text-neutral-400">
                        {item.etiqueta}
                      </dt>
                      <dd class="text-sm font-semibold text-neutral-900">
                        {item.valor}
                      </dd>
                    </div>
                  </div>
                ))}
              </dl>
            </div>
          )}

          {archivos.length > 0 && (
            <div class="rounded-3xl border border-neutral-200 bg-neutral-50/60 p-6">
              <p class="text-xs font-semibold uppercase tracking-widest text-neutral-400">
                Documentos
              </p>
              <ul class="mt-5 space-y-2.5">
                {archivos.map((archivo) => (
                  <li>
                    <a
                      href={`${API_URL}${archivo.url}`}
                      target="_blank"
                      rel="noreferrer"
                      download
                      class="group flex items-center gap-3 rounded-xl border border-neutral-200 bg-white p-3 transition-all duration-300 hover:border-[#38b000]/40 hover:shadow-sm"
                    >
                      <div class="flex h-9 w-9 shrink-0 items-center justify-center rounded-lg bg-[#38b000]/10 text-[#38b000]">
                        <Icon
                          name={ICONO_POR_EXTENSION[archivo.ext?.toLowerCase()] ?? "lucide:file"}
                          class="h-4 w-4"
                        />
                      </div>
                      <div class="min-w-0 flex-1">
                        <p class="truncate text-xs font-semibold text-neutral-900">
                          {archivo.name}
                        </p>
                        <p class="text-xs text-neutral-400">
                          {formatearTamano(archivo.size)}
                        </p>
                      </div>
                      <Icon
                        name="lucide:download"
                        class="h-4 w-4 shrink-0 text-neutral-400 transition-colors group-hover:text-[#38b000]"
                      />
                    </a>
                  </li>
                ))}
              </ul>
            </div>
          )}
        </aside>
      )}
    </div>
  </div>
</article>
