---
import { Icon } from "astro-icon/components";
import { API_URL } from "../../../lib/Fetch-Public-Informacion";
import type { object_blog } from "../types/tp-blog";

interface Props {
  post: object_blog;
}

const { post } = Astro.props;

const inicial = (post.titulo ?? "B").trim().charAt(0).toUpperCase();
const imagen = post.documentos?.[0];
const categorias = post.categoria_blogs ?? [];

const fechaPublicacion = post.publishedAt
  ? new Intl.DateTimeFormat("es-DO", { dateStyle: "long" }).format(
      new Date(post.publishedAt),
    )
  : null;

const palabras = post.contenido?.trim().split(/\s+/).length ?? 0;
const tiempoLectura = palabras > 0 ? `${Math.max(1, Math.ceil(palabras / 200))} min de lectura` : null;

// El contenido puede venir como texto plano o markdown simple desde el CMS;
// se separa en párrafos para no depender de un renderer de rich text.
const parrafos = (post.contenido ?? "").split(/\n{2,}/).filter(Boolean);
---

<article class="relative overflow-hidden px-6 py-16 sm:px-10 sm:py-20">
  <!-- Fondos decorativos -->
  <div class="pointer-events-none absolute inset-0 -z-10">
    <div class="absolute left-1/2 top-0 h-100 w-100 -translate-x-1/2 rounded-full bg-linear-to-b from-[#38b000]/12 to-transparent blur-3xl"></div>
  </div>

  <div class="relative mx-auto max-w-3xl">
    <!-- Volver -->
    <a
      href="/blog"
      class="group inline-flex items-center gap-2 text-sm font-medium text-neutral-500 transition-colors hover:text-[#38b000]"
    >
      <Icon
        name="lucide:arrow-left"
        class="h-4 w-4 transition-transform duration-300 group-hover:-translate-x-1"
      />
      Volver al blog
    </a>

    <!-- Encabezado -->
    <header class="mt-8">
      {categorias[0] && (
        <span class="inline-flex items-center gap-2 rounded-full border border-[#38b000]/20 bg-[#38b000]/10 px-4 py-1.5 text-xs font-bold uppercase tracking-widest text-[#38b000]">
          <Icon name="lucide:tag" class="h-3.5 w-3.5" />
          {categorias[0].nombre}
        </span>
      )}

      <h1 class="mt-5 text-balance text-3xl font-black tracking-tight text-neutral-900 sm:text-5xl">
        {post.titulo}
      </h1>
      {post.subtitulo && (
        <p class="mt-3 text-lg text-neutral-500">{post.subtitulo}</p>
      )}

      <div class="mt-6 flex flex-wrap items-center gap-4 text-sm font-medium text-neutral-500">
        <span class="inline-flex items-center gap-2">
          <span class="flex h-7 w-7 items-center justify-center rounded-full bg-[#38b000]/10 text-xs font-bold text-[#38b000]">
            U
          </span>
          Urpirio
        </span>
        {fechaPublicacion && (
          <span class="inline-flex items-center gap-1.5">
            <Icon name="lucide:calendar" class="h-4 w-4" />
            {fechaPublicacion}
          </span>
        )}
        {tiempoLectura && (
          <span class="inline-flex items-center gap-1.5">
            <Icon name="lucide:clock" class="h-4 w-4" />
            {tiempoLectura}
          </span>
        )}
      </div>
    </header>

    <!-- Portada -->
    <div class="mt-10 flex aspect-video w-full items-center justify-center overflow-hidden rounded-3xl border border-neutral-200 bg-linear-to-br from-[#38b000]/12 via-neutral-50 to-[#38b000]/5">
      {imagen ? (
        <img
          src={`${API_URL}${imagen.url}`}
          alt={imagen.alternativeText ?? post.titulo}
          class="h-full w-full object-cover"
          loading="lazy"
        />
      ) : (
        <span class="text-8xl font-black text-[#38b000]/25 sm:text-9xl">
          {inicial}
        </span>
      )}
    </div>

    <!-- Contenido -->
    <div class="prose-blog mt-12 space-y-5">
      {parrafos.length > 0 ? (
        parrafos.map((parrafo) => (
          <p class="text-lg leading-relaxed text-neutral-700">{parrafo}</p>
        ))
      ) : (
        <p class="text-lg leading-relaxed text-neutral-700">{post.contenido}</p>
      )}
    </div>

    <!-- Compartir -->
    <div class="mt-14 flex flex-wrap items-center justify-between gap-4 border-t border-neutral-200 pt-8">
      <a
        href="/blog"
        class="group inline-flex items-center gap-2 text-sm font-semibold text-neutral-800 transition-colors hover:text-[#38b000]"
      >
        <Icon
          name="lucide:arrow-left"
          class="h-4 w-4 transition-transform duration-300 group-hover:-translate-x-1"
        />
        Ver todas las publicaciones
      </a>

      <div class="flex gap-2">
        <a
          href={`https://twitter.com/intent/tweet?url=${Astro.url.href}&text=${encodeURIComponent(post.titulo)}`}
          target="_blank"
          rel="noreferrer"
          aria-label="Compartir en X"
          class="flex h-10 w-10 items-center justify-center rounded-full border border-neutral-300 text-neutral-700 transition-all duration-300 hover:border-[#38b000] hover:text-[#38b000]"
        >
          <Icon name="simple-icons:x" class="h-4 w-4" />
        </a>
        <a
          href={`https://www.linkedin.com/sharing/share-offsite/?url=${Astro.url.href}`}
          target="_blank"
          rel="noreferrer"
          aria-label="Compartir en LinkedIn"
          class="flex h-10 w-10 items-center justify-center rounded-full border border-neutral-300 text-neutral-700 transition-all duration-300 hover:border-[#38b000] hover:text-[#38b000]"
        >
          <Icon name="simple-icons:linkedin" class="h-4 w-4" />
        </a>
      </div>
    </div>
  </div>
</article>
