---
import { Icon } from "astro-icon/components";
import { API_URL } from "../../../lib/Fetch-Public-Informacion";
import {
  parseContenido,
  extraerTextoPlano,
} from "../../../lib/parse-rich-text";
import RichSegmento from "../../share-ui/RichSegmento.astro";
import CarouselImagenes from "../../share-ui/CarouselImagenes.astro";
import type { object_blog } from "../types/tp-blog";

interface Props {
  post: object_blog;
}

const { post } = Astro.props;

const inicial = (post.titulo ?? "B").trim().charAt(0).toUpperCase();
const imagenes = post.imagenes ?? [];
const categorias = post.categoria_blogs ?? [];
const archivos = post.documentos ?? [];
const fuentes = post.fuentes ?? [];
const autor = post.autores_de_articulo;

const nombreAutor = autor
  ? [autor.nombe, autor.apellido].filter(Boolean).join(" ")
  : "Urpirio";
const inicialAutor = nombreAutor.trim().charAt(0).toUpperCase();

const fechaPublicacion = post.publishedAt
  ? new Intl.DateTimeFormat("es-DO", { dateStyle: "long" }).format(
      new Date(post.publishedAt),
    )
  : null;

const textoPlano = extraerTextoPlano(post.articulo);
const palabras = textoPlano ? textoPlano.split(/\s+/).length : 0;
const tiempoLectura =
  palabras > 0
    ? `${Math.max(1, Math.ceil(palabras / 200))} min de lectura`
    : null;

const bloques = parseContenido(post.articulo);

const ICONO_POR_EXTENSION: Record<string, string> = {
  ".pdf": "lucide:file-text",
  ".doc": "lucide:file-text",
  ".docx": "lucide:file-text",
  ".xls": "lucide:file-spreadsheet",
  ".xlsx": "lucide:file-spreadsheet",
  ".zip": "lucide:file-archive",
  ".rar": "lucide:file-archive",
};

const formatearTamano = (kb: number) => {
  if (kb < 1024) return `${Math.round(kb)} KB`;
  return `${(kb / 1024).toFixed(1)} MB`;
};
---

<article class="relative overflow-hidden py-16 sm:py-20">
  <!-- Fondos decorativos -->
  <div class="pointer-events-none absolute inset-0 -z-10">
    <div
      class="absolute left-1/2 top-0 h-100 w-100 -translate-x-1/2 rounded-full bg-linear-to-b from-[#38b000]/12 to-transparent blur-3xl"
    >
    </div>
  </div>

  <div class="relative mx-auto max-w-6xl">
    <!-- Volver -->
    <a
      href="/articulos"
      class="group inline-flex items-center gap-2 text-sm font-medium text-neutral-500 transition-colors hover:text-[#38b000]"
    >
      <Icon
        name="lucide:arrow-left"
        class="h-4 w-4 transition-transform duration-300 group-hover:-translate-x-1"
      />
      Volver a artículos
    </a>

    <!-- Encabezado -->
    <header class="mt-8">
      {
        categorias.length > 0 && (
          <div class="flex flex-wrap gap-2">
            {categorias.map((cat) => (
              <span class="inline-flex items-center gap-2 rounded-full border border-[#38b000]/20 bg-[#38b000]/10 px-4 py-1.5 text-xs font-bold uppercase tracking-widest text-[#38b000]">
                <Icon name="lucide:tag" class="h-3.5 w-3.5" />
                {cat.nombre}
              </span>
            ))}
          </div>
        )
      }

      <h1
        class="mt-5 text-balance text-3xl font-black tracking-tight text-neutral-900 sm:text-5xl"
      >
        {post.titulo}
      </h1>
      {
        post.subtitulo && (
          <p class="mt-3 text-lg text-neutral-500">{post.subtitulo}</p>
        )
      }

      <div
        class="mt-6 flex flex-wrap items-center gap-4 text-sm font-medium text-neutral-500"
      >
        <span class="inline-flex items-center gap-2">
          <span
            class="flex h-7 w-7 items-center justify-center rounded-full bg-[#38b000]/10 text-xs font-bold text-[#38b000]"
          >
            {inicialAutor}
          </span>
          {nombreAutor}
        </span>
        {
          fechaPublicacion && (
            <span class="inline-flex items-center gap-1.5">
              <Icon name="lucide:calendar" class="h-4 w-4" />
              {fechaPublicacion}
            </span>
          )
        }
        {
          tiempoLectura && (
            <span class="inline-flex items-center gap-1.5">
              <Icon name="lucide:clock" class="h-4 w-4" />
              {tiempoLectura}
            </span>
          )
        }
      </div>
    </header>

    <!-- Portada -->
    <div class="mt-10">
      <CarouselImagenes
        imagenes={imagenes}
        alt={post.titulo}
        inicial={inicial}
      />
    </div>

    <!-- Contenido -->
    <div class="prose-blog mt-12 space-y-5">
      {
        bloques.length > 0 ? (
          bloques.map((bloque) => {
            if (bloque.tipo === "titulo") {
              const TagTitulo = bloque.nivel === 2 ? "h2" : "h3";
              return (
                <TagTitulo class="text-2xl font-bold text-neutral-900">
                  {bloque.segmentos!.map((seg) => (
                    <RichSegmento {...seg} />
                  ))}
                </TagTitulo>
              );
            }
            if (bloque.tipo === "lista") {
              const TagLista = bloque.ordenada ? "ol" : "ul";
              return (
                <TagLista class="space-y-2">
                  {bloque.items!.map((item) => (
                    <li class="flex gap-2.5 text-lg leading-relaxed text-neutral-700">
                      <Icon
                        name="lucide:check"
                        class="mt-1.5 h-4 w-4 shrink-0 text-[#38b000]"
                      />
                      <span>
                        {item.map((seg) => (
                          <RichSegmento {...seg} />
                        ))}
                      </span>
                    </li>
                  ))}
                </TagLista>
              );
            }
            if (bloque.tipo === "cita") {
              return (
                <blockquote class="border-l-4 border-[#38b000]/30 pl-4 text-lg italic leading-relaxed text-neutral-600">
                  {bloque.segmentos!.map((seg) => (
                    <RichSegmento {...seg} />
                  ))}
                </blockquote>
              );
            }
            return (
              <p class="text-lg leading-relaxed text-neutral-700">
                {bloque.segmentos!.map((seg) => (
                  <RichSegmento {...seg} />
                ))}
              </p>
            );
          })
        ) : (
          <p class="text-lg leading-relaxed text-neutral-700">
            {post.subtitulo}
          </p>
        )
      }
    </div>

    <!-- Fuentes -->
    {
      fuentes.length > 0 && (
        <div class="mt-10 rounded-2xl border border-neutral-200 bg-neutral-50/60 p-6">
          <p class="text-xs font-semibold uppercase tracking-widest text-neutral-400">
            Fuentes
          </p>
          <ul class="mt-4 space-y-2">
            {fuentes.map((fuente) => (
              <li>
                <a
                  href={fuente.url}
                  target="_blank"
                  rel="noreferrer"
                  class="group inline-flex items-start gap-2 text-sm text-neutral-600 transition-colors hover:text-[#38b000]"
                >
                  <Icon
                    name="lucide:link"
                    class="mt-0.5 h-3.5 w-3.5 shrink-0"
                  />
                  <span class="group-hover:underline">{fuente.titulo}</span>
                </a>
              </li>
            ))}
          </ul>
        </div>
      )
    }

    <!-- Documentos -->
    {
      archivos.length > 0 && (
        <div class="mt-6 rounded-2xl border border-neutral-200 bg-neutral-50/60 p-6">
          <p class="text-xs font-semibold uppercase tracking-widest text-neutral-400">
            Documentos
          </p>
          <ul class="mt-4 space-y-2.5">
            {archivos.map((archivo) => (
              <li>
                <a
                  href={`${API_URL}${archivo.url}`}
                  target="_blank"
                  rel="noreferrer"
                  download
                  class="group flex items-center gap-3 rounded-xl border border-neutral-200 bg-white p-3 transition-all duration-300 hover:border-[#38b000]/40 hover:shadow-sm"
                >
                  <div class="flex h-9 w-9 shrink-0 items-center justify-center rounded-lg bg-[#38b000]/10 text-[#38b000]">
                    <Icon
                      name={
                        ICONO_POR_EXTENSION[archivo.ext?.toLowerCase()] ??
                        "lucide:file"
                      }
                      class="h-4 w-4"
                    />
                  </div>
                  <div class="min-w-0 flex-1">
                    <p class="truncate text-xs font-semibold text-neutral-900">
                      {archivo.name}
                    </p>
                    <p class="text-xs text-neutral-400">
                      {formatearTamano(archivo.size)}
                    </p>
                  </div>
                  <Icon
                    name="lucide:download"
                    class="h-4 w-4 shrink-0 text-neutral-400 transition-colors group-hover:text-[#38b000]"
                  />
                </a>
              </li>
            ))}
          </ul>
        </div>
      )
    }
  </div>
</article>
