---
import { Image } from "astro:assets";
import { Icon } from "astro-icon/components";
import Urpiriodev from "../../../assets/foto_sin_fondo.png";

const contacto = [
  {
    titulo: "GitHub",
    href: "https://github.com/Urpirio",
    icon: "simple-icons:github",
  },
  {
    titulo: "LinkedIn",
    href: "https://do.linkedin.com/in/urpiriojunior-moreno-vargas-95294b269",
    icon: "simple-icons:linkedin",
  },
  {
    titulo: "Email",
    href: "mailto:UrpirioJunior@gmail.com",
    icon: "lucide:mail",
  },
];

const datos = [
  { icon: "lucide:map-pin", texto: "Santo Domingo, RD" },
  { icon: "lucide:phone", texto: "+1 (849) 257-7007" },
  { icon: "lucide:globe", texto: "urpiriodev.com.do" },
];
---

<section class="relative overflow-hidden px-6 py-16 sm:px-10 lg:py-24">
  <!-- Fondos decorativos -->
  <div class="pointer-events-none absolute inset-0 -z-10">
    <div class="absolute -right-20 top-0 h-125 w-125 rounded-full bg-linear-to-b from-[#38b000]/12 to-transparent blur-3xl"></div>
  </div>

  <div class="mx-auto grid max-w-6xl grid-cols-1 items-center gap-12 lg:grid-cols-[1fr_1.4fr]">
    <!-- Foto -->
    <div class="relative mx-auto flex h-80 w-full max-w-xs items-end justify-center sm:h-96">
      <div class="pointer-events-none absolute inset-0 flex items-center justify-center">
        <div class="absolute h-72 w-72 rounded-full bg-linear-to-b from-[#38b000]/15 to-transparent blur-2xl"></div>
        <div class="absolute h-72 w-72 rounded-full border border-[#38b000]/20"></div>
        <div class="absolute h-60 w-60 rounded-full border border-dashed border-[#38b000]/15"></div>
      </div>
      <Image
        class="relative z-10 h-full w-auto object-contain object-bottom mask-b-from-85% mask-b-to-95%"
        src={Urpiriodev}
        alt="Urpirio Junior Moreno Vargas"
      />
    </div>

    <!-- Info -->
    <div class="text-center lg:text-left">
      <span class="inline-flex items-center gap-2 rounded-full border border-[#38b000]/20 bg-[#38b000]/10 px-4 py-1.5 text-xs font-semibold uppercase tracking-widest text-[#38b000]">
        <span class="h-2 w-2 rounded-full bg-[#38b000]"></span>
        Sobre mí
      </span>

      <h1 class="mt-6 text-balance text-4xl font-black leading-tight tracking-tight text-neutral-900 sm:text-5xl">
        Urpirio Junior <span class="text-[#38b000]">Moreno Vargas</span>
      </h1>

      <p class="mt-3 text-lg font-medium text-neutral-500">
        Desarrollador de software y especialista en soluciones digitales.
      </p>

      <div class="mt-6 flex flex-wrap justify-center gap-4 lg:justify-start">
        {
          datos.map((dato) => (
            <span class="inline-flex items-center gap-2 text-sm text-neutral-500">
              <Icon name={dato.icon} class="h-4 w-4 text-[#38b000]" />
              {dato.texto}
            </span>
          ))
        }
      </div>

      <div class="mt-8 flex flex-wrap items-center justify-center gap-3 lg:justify-start">
        <a
          href="mailto:UrpirioJunior@gmail.com"
          class="group inline-flex items-center gap-2 rounded-full bg-linear-to-r from-[#38b000] to-[#2d8d00] px-6 py-3 font-semibold text-white shadow-lg shadow-[#38b000]/20 transition-all duration-300 hover:shadow-xl hover:shadow-[#38b000]/30"
        >
          <Icon name="lucide:mail" class="h-4 w-4" />
          Escríbeme
        </a>
        <div class="flex gap-2">
          {
            contacto.map((red) => (
              <a
                href={red.href}
                target="_blank"
                rel="noreferrer"
                aria-label={red.titulo}
                class="flex h-11 w-11 items-center justify-center rounded-full border border-neutral-300 text-neutral-700 transition-all duration-300 hover:border-[#38b000] hover:text-[#38b000]"
              >
                <Icon name={red.icon} class="h-5 w-5" />
              </a>
            ))
          }
        </div>
      </div>
    </div>
  </div>

  <!-- Perfil narrativo -->
  <div class="mx-auto mt-16 max-w-3xl rounded-3xl border border-neutral-200 bg-white/60 p-8 backdrop-blur-sm sm:p-10">
    <p class="leading-relaxed text-neutral-600">
      Soy desarrollador de software con experiencia en el diseño y desarrollo de
      interfaces modernas y escalables para plataformas <strong class="font-semibold text-neutral-900">web y móviles</strong>.
      Me especializo en frontend de alta calidad, respaldado por una base sólida
      en backend, bases de datos, despliegue de sistemas e integración de
      plataformas, lo que me permite aportar de principio a fin.
    </p>
    <p class="mt-4 leading-relaxed text-neutral-600">
      He liderado componentes técnicos de iniciativas nacionales de innovación,
      incluyendo <strong class="font-semibold text-[#38b000]">soluciones basadas en IA en el sector público</strong>,
      trabajando junto a equipos de backend, infraestructura y multidisciplinarios
      para garantizar estabilidad, seguridad, escalabilidad y rendimiento. Me
      siento cómodo asumiendo responsabilidades full-stack cuando hace falta.
    </p>
  </div>
</section>
