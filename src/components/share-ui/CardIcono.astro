---
import { Icon } from "astro-icon/components";

interface Props {
  icono: string;
  titulo: string;
  subtitulo?: string;
  class?: string;
}

const { icono, titulo, subtitulo, class: className } = Astro.props;
---

<div
  class:list={[
    "group relative overflow-hidden rounded-2xl border border-neutral-200 bg-neutral-50/60 p-5 text-left transition-all duration-300 hover:-translate-y-1 hover:border-[#38b000]/40 hover:bg-white hover:shadow-md",
    className,
  ]}
>
  <div class="flex h-10 w-10 items-center justify-center rounded-xl bg-[#38b000]/10 text-[#38b000] transition-colors duration-300 group-hover:bg-[#38b000]/20">
    <Icon name={icono} class="h-5 w-5" />
  </div>
  <h3 class="mt-3 text-base font-bold text-neutral-900">{titulo}</h3>
  {
    subtitulo && (
      <p class="mt-1.5 text-sm leading-relaxed text-neutral-600">{subtitulo}</p>
    )
  }
</div>
