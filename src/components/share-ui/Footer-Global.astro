---
import { Icon } from "astro-icon/components";
import { Fetch } from "../../lib/Fetch-Public-Informacion";
import { resolverRedes } from "../../lib/redes-sociales";
import type { tp_footer } from "./types/tp-footer";

const enlaces = [
  { titulo: "Inicio", href: "/" },
  { titulo: "Proyectos", href: "/proyectos" },
  { titulo: "Sobre mí", href: "/sobre-me" },
  { titulo: "Artículos", href: "/articulos" },
];

const data: tp_footer = await Fetch({ pathname: "/api/footer?populate=*" });
const footer = data?.data;

const descripcion =
  footer?.descripcion ||
  "Desarrollador de software dominicano. Construyo sitios y aplicaciones rápidas, limpias y a medida.";
const ubicacion = footer?.ubicacion || "Santo Domingo, República Dominicana";

const redesCms = resolverRedes(footer?.redes_sociales);
const redes = redesCms.length > 0 ? redesCms : [
  {
    titulo: "GitHub",
    href: "https://github.com/Urpirio",
    icon: "simple-icons:github",
  },
  {
    titulo: "LinkedIn",
    href: "https://do.linkedin.com/in/urpiriojunior-moreno-vargas-95294b269",
    icon: "simple-icons:linkedin",
  },
  {
    titulo: "Instagram",
    href: "https://instagram.com",
    icon: "simple-icons:instagram",
  },
  {
    titulo: "Email",
    href: "mailto:UrpirioJunior@gmail.com",
    icon: "lucide:mail",
  },
];

const year = new Date().getFullYear();
---

<footer
  class="footer-root relative overflow-hidden border-t border-neutral-200 bg-neutral-50 px-6 py-16 text-neutral-900 sm:px-10"
>
  <!-- Fondos decorativos (coherentes con el resto del sitio) -->
  <div class="pointer-events-none absolute inset-0 z-0">
    <div class="absolute left-1/2 top-0 h-96 w-96 -translate-x-1/2 rounded-full bg-linear-to-b from-[#38b000]/10 to-transparent blur-3xl"></div>
    <div class="absolute inset-0 bg-[linear-gradient(to_right,rgba(56,176,0,0.04)_1px,transparent_1px),linear-gradient(to_bottom,rgba(56,176,0,0.04)_1px,transparent_1px)] bg-size-[56px_56px] mask-[radial-gradient(ellipse_at_center,black,transparent_75%)]"></div>
  </div>

  <div class="relative z-10 mx-auto max-w-6xl">
    <div class="grid grid-cols-1 gap-10 sm:grid-cols-2 lg:grid-cols-[2fr_1fr_1.4fr]">
      <!-- Columna Marca -->
      <div class="footer-col max-w-xs">
        <a href="/" class="inline-flex items-center gap-2 text-xl font-black tracking-tight text-neutral-900">
          <span class="relative flex h-2.5 w-2.5">
            <span class="absolute inline-flex h-full w-full animate-ping rounded-full bg-[#38b000] opacity-70"></span>
            <span class="relative inline-flex h-2.5 w-2.5 rounded-full bg-[#38b000]"></span>
          </span>
          <span>urpirio<span class="text-[#38b000]">.dev</span></span>
        </a>
        <p class="mt-5 text-sm leading-relaxed text-neutral-500">
          {descripcion}
        </p>

        <div class="mt-6 flex gap-2.5">
          {
            redes.map((red) => (
              <a
                href={red.href}
                target="_blank"
                rel="noreferrer"
                aria-label={red.titulo}
                class="flex h-10 w-10 items-center justify-center rounded-full border border-neutral-200 bg-white text-neutral-500 transition-all duration-300 hover:-translate-y-1 hover:border-[#38b000]/40 hover:text-[#38b000] hover:shadow-sm"
              >
                <Icon name={red.icon} class="h-4.5 w-4.5" />
              </a>
            ))
          }
        </div>
      </div>

      <!-- Columna Navegación -->
      <div class="footer-col">
        <p class="text-xs font-semibold uppercase tracking-widest text-neutral-400">
          Navegación
        </p>
        <ul class="mt-5 flex flex-col gap-3">
          {
            enlaces.map((enlace) => (
              <li>
                <a
                  href={enlace.href}
                  class="group inline-flex items-center gap-2 text-sm text-neutral-600 transition-colors hover:text-neutral-900"
                >
                  <span class="h-1.5 w-1.5 rounded-full bg-neutral-300 transition-all duration-300 group-hover:w-3 group-hover:bg-[#38b000]" />
                  {enlace.titulo}
                </a>
              </li>
            ))
          }
        </ul>
      </div>

      <!-- Columna Contacto -->
      <div class="footer-col">
        <p class="text-xs font-semibold uppercase tracking-widest text-neutral-400">
          ¿Hablamos?
        </p>
        <p class="mt-5 text-sm leading-relaxed text-neutral-500">
          ¿Tienes una idea o proyecto en mente? Escríbeme, me encantaría
          escucharlo.
        </p>
        <a
          href="mailto:UrpirioJunior@gmail.com"
          class="group mt-5 inline-flex items-center gap-2 rounded-full bg-linear-to-r from-[#38b000] to-[#2d8d00] px-5 py-2.5 text-sm font-semibold text-white shadow-lg shadow-[#38b000]/20 transition-all duration-300 hover:shadow-xl hover:shadow-[#38b000]/30"
        >
          <Icon name="lucide:mail" class="h-4 w-4" />
          UrpirioJunior@gmail.com
        </a>
        <p class="mt-5 flex items-center gap-2 text-sm text-neutral-500">
          <Icon name="lucide:map-pin" class="h-4 w-4 text-[#38b000]" />
          {ubicacion}
        </p>
      </div>
    </div>

    <!-- Barra inferior -->
    <div class="mt-14 flex flex-col items-center justify-between gap-4 border-t border-neutral-200 pt-6 sm:flex-row">
      <p class="text-xs text-neutral-400">
        © {year} Urpirio Junior Moreno Vargas. Hecho con Astro y mucho café.
      </p>

      <a
        href="#top"
        class="group flex items-center gap-1.5 text-xs font-semibold text-neutral-500 transition-colors hover:text-[#38b000]"
      >
        <span>Volver arriba</span>
        <Icon
          name="lucide:arrow-up"
          class="h-3.5 w-3.5 transition-transform duration-300 group-hover:-translate-y-1"
        />
      </a>
    </div>
  </div>
</footer>

<script>
  import { animate, inView, stagger } from "motion";

  const cols = document.querySelectorAll<HTMLElement>(".footer-col");

  if (cols.length) {
    inView(
      ".footer-root",
      () => {
        animate(
          cols,
          { opacity: [0, 1], y: [24, 0] },
          {
            duration: 0.6,
            delay: stagger(0.12),
            ease: [0.22, 1, 0.36, 1],
          },
        );
      },
      { amount: 0.3 },
    );
  }
</script>
