---
import { Icon } from "astro-icon/components";

interface Props {
  titulo: string;
  descripcion?: string;
  subtitulo?: string;
  categoria?: string;
  tecnologias?: string[];
  imagen?: string;
  /** Si se define, toda la tarjeta enlaza aquí (sin botones de acción). */
  href?: string;
  /** Botón principal (abre en nueva pestaña). */
  urlProyecto?: string;
  /** Botón secundario a GitHub. */
  urlGithub?: string;
  maxTecnologias?: number;
  class?: string;
  /** Permite pasar atributos data-* (ej. para filtros). */
  [key: string]: any;
}

const {
  titulo,
  descripcion,
  subtitulo,
  categoria,
  tecnologias = [],
  imagen,
  href,
  urlProyecto,
  urlGithub,
  maxTecnologias = 4,
  class: className,
  ...rest
} = Astro.props;

const inicial = (titulo ?? "P").trim().charAt(0).toUpperCase();
const techs = tecnologias.slice(0, maxTecnologias);
const restantes = tecnologias.length - techs.length;
const tieneAcciones = Boolean(urlProyecto || urlGithub);
---

<article
  class:list={[
    "group relative flex flex-col overflow-hidden rounded-3xl border border-neutral-200/90 bg-white p-2 shadow-[0_4px_20px_-4px_rgba(0,0,0,0.05)] transition-all duration-500 hover:-translate-y-1.5 hover:border-[#38b000]/40 hover:shadow-[0_20px_40px_-15px_rgba(56,176,0,0.18)]",
    className,
  ]}
  {...rest}
>
  {
    href && (
      <a href={href} class="absolute inset-0 z-10" aria-label={titulo} />
    )
  }

  <!-- Imagen / Placeholder -->
  <div class="relative h-48 w-full overflow-hidden rounded-2xl bg-neutral-100">
    {
      imagen ? (
        <img
          src={imagen}
          alt={titulo}
          class="h-full w-full object-cover transition-transform duration-700 group-hover:scale-105"
          loading="lazy"
        />
      ) : (
        <div class="flex h-full w-full items-center justify-center bg-linear-to-br from-[#38b000]/12 via-neutral-50 to-[#38b000]/5">
          <span class="text-6xl font-black text-[#38b000]/25">{inicial}</span>
        </div>
      )
    }

    {
      categoria && (
        <span class="absolute left-3 top-3 rounded-full bg-white/90 px-3 py-1 text-xs font-semibold text-neutral-700 shadow-sm backdrop-blur">
          {categoria}
        </span>
      )
    }
  </div>

  <!-- Contenido -->
  <div class="flex flex-1 flex-col p-4">
    <div class="flex items-start justify-between gap-2">
      <h3 class="line-clamp-1 text-lg font-bold text-neutral-900 transition-colors group-hover:text-[#38b000]">
        {titulo}
      </h3>
      {
        subtitulo && (
          <span class="whitespace-nowrap rounded-md bg-neutral-100 px-2 py-0.5 text-xs font-medium text-neutral-600">
            {subtitulo}
          </span>
        )
      }
    </div>

    {
      descripcion && (
        <p class="mt-2 line-clamp-3 flex-1 text-sm leading-relaxed text-neutral-600">
          {descripcion}
        </p>
      )
    }

    {
      techs.length > 0 && (
        <div class="mt-4 flex flex-wrap gap-1.5">
          {techs.map((t) => (
            <span class="rounded-full border border-[#38b000]/20 bg-[#38b000]/10 px-3 py-1 text-xs font-semibold text-[#2d8d00]">
              {t}
            </span>
          ))}
          {restantes > 0 && (
            <span class="rounded-full bg-neutral-100 px-2.5 py-1 text-xs font-medium text-neutral-500">
              +{restantes}
            </span>
          )}
        </div>
      )
    }

    {
      tieneAcciones && (
        <div class="mt-6 flex items-center gap-3 border-t border-neutral-100 pt-4">
          {urlProyecto && (
            <a
              href={urlProyecto}
              target="_blank"
              rel="noreferrer"
              class="relative z-20 inline-flex flex-1 items-center justify-center gap-1.5 rounded-xl bg-linear-to-r from-[#38b000] to-[#2d8d00] px-4 py-2.5 text-center text-xs font-bold text-white shadow-md shadow-[#38b000]/20 transition-all duration-300 hover:scale-[1.02] hover:shadow-lg hover:shadow-[#38b000]/30 active:scale-[0.98]"
            >
              <Icon name="lucide:external-link" class="h-3.5 w-3.5" />
              <span>Ver proyecto</span>
            </a>
          )}
          {urlGithub && (
            <a
              href={urlGithub}
              target="_blank"
              rel="noreferrer"
              aria-label="Ver código en GitHub"
              class="relative z-20 inline-flex items-center justify-center gap-1.5 rounded-xl border border-neutral-300 bg-neutral-50 px-4 py-2.5 text-xs font-bold text-neutral-800 transition-all duration-300 hover:scale-[1.02] hover:border-neutral-900 hover:bg-neutral-900 hover:text-white active:scale-[0.98]"
            >
              <Icon name="simple-icons:github" class="h-3.5 w-3.5" />
              <span>GitHub</span>
            </a>
          )}
        </div>
      )
    }

    {
      href && !tieneAcciones && (
        <span class="mt-4 inline-flex items-center gap-1.5 text-xs font-bold text-[#38b000]">
          Ver proyecto
          <Icon
            name="lucide:arrow-right"
            class="h-3.5 w-3.5 transition-transform duration-300 group-hover:translate-x-1"
          />
        </span>
      )
    }
  </div>
</article>
