---
import { Icon } from "astro-icon/components";

interface Props {
  titulo: string;
  resumen?: string;
  categoria?: string;
  imagen?: string;
  fecha?: string;
  tiempoLectura?: string;
  href: string;
  class?: string;
  [key: string]: any;
}

const {
  titulo,
  resumen,
  categoria,
  imagen,
  fecha,
  tiempoLectura,
  href,
  class: className,
  ...rest
} = Astro.props;

const inicial = (titulo ?? "B").trim().charAt(0).toUpperCase();
---

<article
  class:list={[
    "group relative flex flex-col overflow-hidden rounded-3xl border border-neutral-200/90 bg-white p-2 shadow-[0_4px_20px_-4px_rgba(0,0,0,0.05)] transition-all duration-500 hover:-translate-y-1.5 hover:border-[#38b000]/40 hover:shadow-[0_20px_40px_-15px_rgba(56,176,0,0.18)]",
    className,
  ]}
  {...rest}
>
  <a href={href} class="absolute inset-0 z-10" aria-label={titulo} />

  <!-- Imagen / Placeholder -->
  <div class="relative h-48 w-full overflow-hidden rounded-2xl bg-neutral-100">
    {
      imagen ? (
        <img
          src={imagen}
          alt={titulo}
          class="h-full w-full object-cover transition-transform duration-700 group-hover:scale-105"
          loading="lazy"
        />
      ) : (
        <div class="flex h-full w-full items-center justify-center bg-linear-to-br from-[#38b000]/12 via-neutral-50 to-[#38b000]/5">
          <span class="text-6xl font-black text-[#38b000]/25">{inicial}</span>
        </div>
      )
    }

    {
      categoria && (
        <span class="absolute left-3 top-3 rounded-full bg-white/90 px-3 py-1 text-xs font-semibold text-neutral-700 shadow-sm backdrop-blur">
          {categoria}
        </span>
      )
    }
  </div>

  <!-- Contenido -->
  <div class="flex flex-1 flex-col p-4">
    <h3 class="line-clamp-2 text-lg font-bold text-neutral-900 transition-colors group-hover:text-[#38b000]">
      {titulo}
    </h3>

    {
      resumen && (
        <p class="mt-2 line-clamp-3 flex-1 text-sm leading-relaxed text-neutral-600">
          {resumen}
        </p>
      )
    }

    {
      (fecha || tiempoLectura) && (
        <div class="mt-4 flex items-center gap-4 border-t border-neutral-100 pt-4 text-xs font-medium text-neutral-500">
          {fecha && (
            <span class="inline-flex items-center gap-1.5">
              <Icon name="lucide:calendar" class="h-3.5 w-3.5" />
              {fecha}
            </span>
          )}
          {tiempoLectura && (
            <span class="inline-flex items-center gap-1.5">
              <Icon name="lucide:clock" class="h-3.5 w-3.5" />
              {tiempoLectura}
            </span>
          )}
        </div>
      )
    }

    <span class="relative z-20 mt-4 inline-flex items-center gap-1.5 text-xs font-bold text-[#38b000]">
      Leer artículo
      <Icon
        name="lucide:arrow-right"
        class="h-3.5 w-3.5 transition-transform duration-300 group-hover:translate-x-1"
      />
    </span>
  </div>
</article>
